rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidRecord(data) {
      return data.keys().hasAll(['department', 'program', 'session', 'semester']) &&
             data.department is string &&
             data.program is string &&
             data.session is string &&
             data.semester is string;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['username', 'role', 'department']) &&
             data.username is string &&
             data.role is string &&
             data.department is string;
    }

    function isValidLog(data) {
      return data.keys().hasAll(['userName', 'action', 'timestamp']) &&
             data.userName is string &&
             data.action is string &&
             data.timestamp is string;
    }

    match /records/{recordId} {
      allow read: if true;
      allow write: if isValidRecord(request.resource.data);
      allow delete: if true;
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if isValidUser(request.resource.data);
      allow delete: if true;
    }

    match /config/{configKey} {
      allow read: if true;
      allow write: if true;
    }

    match /logs/{logId} {
      allow read: if true;
      allow create: if isValidLog(request.resource.data);
      allow update, delete: if false;
    }

    match /requisitions/{reqId} {
      allow read: if true;
      allow write: if true;
      allow delete: if true;
    }

    match /test/{docId} {
      allow read, write: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

