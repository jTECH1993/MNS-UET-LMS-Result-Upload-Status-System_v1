rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /records/{recordId} {
      allow read, write: if true;
    }
    match /users/{userId} {
      allow read, write: if true;
    }
    match /config/{configKey} {
      allow read, write: if true;
    }
    match /logs/{logId} {
      allow read, write: if true;
    }
    match /requisitions/{reqId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
